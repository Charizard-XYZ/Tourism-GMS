# ============================================================
# Tourism-GMS Environment Configuration Template
# ============================================================
# Copy this file to .env and provide your specific credentials.
# Do NOT commit .env or real credentials to version control.

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:4200

# Firebase Project Configuration
FIREBASE_PROJECT_ID=tourism-gms
# Optional: Path to Firebase service account JSON if not placed in server/src/config/
# FIREBASE_SERVICE_ACCOUNT_PATH=server/src/config/tourism-gms-firebase-adminsdk-fbsvc-56a698dd84.json

# ============================================================
# Nodemailer SMTP Email Service Configuration
# ============================================================
# Hostname of the mail server (e.g. smtp.gmail.com, smtp.mailgun.org, smtp.office365.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port: typically 587 (TLS/STARTTLS) or 465 (SSL)
SMTP_PORT=587

# Set to 'true' if using port 465 (SSL), or 'false' for port 587 (TLS/STARTTLS)
SMTP_SECURE=false

# SMTP authentication username / account email
SMTP_USER=tourismgms@gmail.com

# SMTP authentication password / App-specific password (never use master password)
SMTP_PASSWORD=yklg zcvy dgtp isky

# Sender display name and email address for outgoing notification emails
SMTP_FROM="Tourism-GMS Redressal Portal" <noreply@tourismgms@gmail.com>

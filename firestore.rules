rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isOfficer() {
      return isAuthenticated() && getUserData().role == 'officer';
    }

    function isTourist() {
      return isAuthenticated() && getUserData().role == 'tourist';
    }

    // Users Collection: users/{uid}
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can update their own name/phone, but cannot change role or uid
      allow update: if isOwner(userId) 
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow create, delete: if isAdmin();
    }

    // Departments Collection: departments/{deptId}
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Officers Collection: officers/{officerId}
    match /officers/{officerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Grievances Collection: grievances/{grievanceId}
    match /grievances/{grievanceId} {
      allow read: if isAuthenticated();
      // Tourists can submit grievances owned by their UID
      allow create: if isAuthenticated() && request.resource.data.touristId == request.auth.uid;
      // Closed grievances are finalized and immutable; otherwise officers, admins, or owning tourists can update
      allow update: if (resource.data.status != 'closed' || isAdmin()) && (
        isAdmin() || isOfficer() || (
          isTourist() && resource.data.touristId == request.auth.uid
        )
      );
      // Resolved or closed grievances cannot be deleted; only admins can delete
      allow delete: if isAdmin() && resource.data.status != 'resolved' && resource.data.status != 'closed';
    }

    // Comments Collection: comments/{commentId}
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Feedbacks Collection: feedbacks/{feedbackId}
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.touristId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications Collection: notifications/{notificationId}
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Activity Logs Collection: activityLogs/{logId}
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs are append-only
    }
  }
}

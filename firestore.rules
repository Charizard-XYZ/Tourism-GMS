rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isOfficer() {
      return isAuthenticated() && getUserData().role == 'officer';
    }

    function isTourist() {
      return isAuthenticated() && getUserData().role == 'tourist';
    }

    // Users Collection: users/{uid}
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can update their own name/phone, but cannot change role or uid
      allow update: if isOwner(userId) 
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow create, delete: if isAdmin();
    }

    // Departments Collection: departments/{deptId}
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Officers Collection: officers/{officerId}
    match /officers/{officerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Grievances Collection: grievances/{grievanceId}
    match /grievances/{grievanceId} {
      allow read: if isAuthenticated();
      // Tourists can submit grievances owned by their UID
      allow create: if isAuthenticated() && request.resource.data.touristId == request.auth.uid;
      // Strictly enforce:
      // - Assigned Officer can update status/resolution (cannot update cancelled grievances)
      // - Tourist can update/cancel only their own grievance
      // - Admin cannot update grievance status, resolve, or cancel
      allow update: if (
        isOfficer() 
          && (resource.data.assignedOfficerId == request.auth.uid || resource.data.assignedOfficerId == request.auth.token.email)
          && resource.data.status != 'cancelled'
      ) || (
        isTourist() && resource.data.touristId == request.auth.uid
      );
      // Strictly enforce: Tourist can permanently delete ONLY their own cancelled grievance. Admin cannot delete grievances.
      allow delete: if isTourist() 
        && resource.data.touristId == request.auth.uid 
        && resource.data.status == 'cancelled';
    }

    // Comments Collection: comments/{commentId}
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Feedback Collection: feedback/{feedbackId}
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.touristId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications Collection: notifications/{notificationId}
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Activity Logs Collection: activityLogs/{logId}
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs are append-only
    }
  }
}
